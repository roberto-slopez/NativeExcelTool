<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <NativeExcelProfile Condition="'$(Configuration)' == 'Release'">release</NativeExcelProfile>
    <NativeExcelProfile Condition="'$(NativeExcelProfile)' == ''">debug</NativeExcelProfile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../bindings/dotnet/NativeExcelNative.cs" Link="NativeExcelNative.cs" />
    <None Include="../../dist/$(NativeExcelProfile)/native_excel_ffi.dll" Link="native_excel_ffi.dll" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
